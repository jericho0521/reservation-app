{
  "name": "@reservation-platform/react",
  "version": "0.1.0",
  "description": "Headless React provider and hooks for the reservation platform.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Project Play maintainers",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "corepack pnpm run build",
    "test": "tsc -p tsconfig.build.json && node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reservation-platform/contract-types": "workspace:^",
    "@reservation-platform/sdk": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
