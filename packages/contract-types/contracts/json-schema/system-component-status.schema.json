          "type": "string"
        },
        "last_success_at": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SystemComponentState"
        }
      },
      "required": [
        "status",
        "action"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/system-component-status.schema.json",
  "$ref": "#/$defs/SystemComponentStatus",
