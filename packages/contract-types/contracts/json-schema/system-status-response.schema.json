{
  "$defs": {
    "SystemComponentState": {
      "enum": [
        "healthy",
        "degraded",
        "offline"
      ],
      "type": "string"
    },
    "SystemComponentStatus": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "last_success_at": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SystemComponentState"
        }
      },
      "required": [
        "status",
        "action"
      ],
      "type": "object"
    },
    "SystemStatusResponse": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": false,
          "properties": {
            "ai": {
              "$ref": "#/$defs/SystemComponentStatus"
            },
            "backup": {
              "$ref": "#/$defs/SystemComponentStatus"
            },
            "database": {
              "$ref": "#/$defs/SystemComponentStatus"
            },
            "disk": {
              "$ref": "#/$defs/SystemComponentStatus"
            },
            "email": {
              "$ref": "#/$defs/SystemComponentStatus"
            },
            "migrations": {
              "$ref": "#/$defs/SystemComponentStatus"
            },
            "whatsapp": {
              "$ref": "#/$defs/SystemComponentStatus"
            },
            "worker": {
              "$ref": "#/$defs/SystemComponentStatus"
            }
          },
          "required": [
            "database",
            "migrations",
            "worker",
            "email",
            "ai",
            "whatsapp",
            "disk",
            "backup"
          ],
          "type": "object"
        },
        "generated_at": {
          "type": "string"
        },
        "jobs": {
          "additionalProperties": false,
          "properties": {
            "failed": {
              "minimum": 0,
              "type": "integer"
            },
            "oldest_age_seconds": {
              "minimum": 0,
              "type": "integer"
            },
            "pending": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "pending",
            "failed",
            "oldest_age_seconds"
          ],
          "type": "object"
        },
        "migration_version": {
          "type": "string"
        },
        "release_version": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SystemComponentState"
        }
      },
      "required": [
        "generated_at",
        "status",
        "release_version",
        "migration_version",
        "components",
        "jobs"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/system-status-response.schema.json",
  "$ref": "#/$defs/SystemStatusResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemStatusResponse"
}
