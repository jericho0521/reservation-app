{
  "$defs": {
    "CustomerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "external_customer_id": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "JsonPrimitive": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "MetadataRecord": {
      "additionalProperties": {
        "$ref": "#/$defs/MetadataValue"
      },
      "type": "object"
    },
    "MetadataValue": {
      "$ref": "#/$defs/JsonPrimitive"
    },
    "PaymentReference": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "payment_reference_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ReservationItemInput": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "minimum": 1,
          "type": "integer"
        },
        "resource_id": {
          "type": "string"
        },
        "resource_label": {
          "type": "string"
        }
      },
      "required": [
        "quantity"
      ],
      "type": "object"
    },
    "ReservationResponse": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "customer": {
          "$ref": "#/$defs/CustomerSnapshot"
        },
        "date": {
          "type": "string"
        },
        "end_at": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "management_expires_at": {
          "type": "string"
        },
        "management_link_status": {
          "enum": [
            "issued",
            "unavailable"
          ],
          "type": "string"
        },
        "management_reissue_required": {
          "type": "boolean"
        },
        "management_token": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "payment_reference": {
          "$ref": "#/$defs/PaymentReference"
        },
        "quantity": {
          "minimum": 1,
          "type": "integer"
        },
        "reservation_id": {
          "type": "string"
        },
        "reservation_items": {
          "items": {
            "$ref": "#/$defs/ReservationItemInput"
          },
          "type": "array"
        },
        "service_id": {
          "type": "string"
        },
        "staff_id": {
          "format": "uuid",
          "type": "string"
        },
        "start_at": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "venue_id": {
          "type": "string"
        }
      },
      "required": [
        "reservation_id",
        "status",
        "service_id",
        "quantity"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/reservation-response.schema.json",
  "$ref": "#/$defs/ReservationResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReservationResponse"
}
