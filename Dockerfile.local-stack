# syntax=docker/dockerfile:1.7

FROM node:24-alpine
WORKDIR /app

RUN apk add --no-cache curl postgresql-client && \
    addgroup -g 1001 -S reservation && \
    adduser -S reservation -u 1001 -G reservation

COPY package.json ./package.json
COPY packages/database/migrations/supabase ./packages/database/migrations/supabase
COPY packages/database/seeds/final-demo.sql ./packages/database/seeds/final-demo.sql
COPY scripts/local-stack-config.mjs ./scripts/local-stack-config.mjs
COPY scripts/local-stack-migrate.mjs ./scripts/local-stack-migrate.mjs
COPY scripts/local-stack-seed.mjs ./scripts/local-stack-seed.mjs
COPY scripts/local-stack-destroy.mjs ./scripts/local-stack-destroy.mjs
COPY scripts/reset-final-demo.mjs ./scripts/reset-final-demo.mjs
COPY scripts/verify-final-demo-readiness.mjs ./scripts/verify-final-demo-readiness.mjs
COPY docker/local-stack/run-with-config.sh /usr/local/bin/run-with-config
RUN chmod 755 /usr/local/bin/run-with-config

CMD ["node", "scripts/local-stack-config.mjs"]
