{
  "$defs": {
    "ExperienceResourceInput": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "is_active": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "label",
        "kind",
        "capacity"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "seat",
        "station",
        "room",
        "court",
        "screening",
        "capacity_bucket",
        "custom"
      ],
      "type": "string"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/experience-resource-input.schema.json",
  "$ref": "#/$defs/ExperienceResourceInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperienceResourceInput"
}
