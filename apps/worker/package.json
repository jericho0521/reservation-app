  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@project-play/reservations-core": "workspace:*",
    "@project-play/reservations-supabase": "workspace:*",
    "@reservation-platform/ai-sdk-adapter": "workspace:*",
    "@reservation-platform/api": "workspace:*",
    "@reservation-platform/contract-types": "workspace:*",
    "@reservation-platform/platform-config": "workspace:*",
    "@reservation-platform/whatsapp": "workspace:*",
    "@supabase/supabase-js": "^2.90.1",
    "nodemailer": "^9.0.3"
