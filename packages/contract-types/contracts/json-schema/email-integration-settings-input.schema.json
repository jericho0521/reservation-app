{
  "$defs": {
    "EmailIntegrationSettingsInput": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "from_address": {
          "format": "email",
          "maxLength": 320,
          "type": "string"
        },
        "from_name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "host": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "password": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string",
          "writeOnly": true
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "tls_mode": {
          "$ref": "#/$defs/EmailTlsMode"
        },
        "username": {
          "maxLength": 320,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "host",
        "port",
        "tls_mode",
        "from_address"
      ],
      "type": "object"
    },
    "EmailTlsMode": {
      "enum": [
        "required",
        "starttls",
        "plain"
      ],
      "type": "string"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/email-integration-settings-input.schema.json",
  "$ref": "#/$defs/EmailIntegrationSettingsInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailIntegrationSettingsInput"
}
