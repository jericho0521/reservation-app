{
  "$defs": {
    "BusinessProfileResponse": {
      "additionalProperties": false,
      "properties": {
        "business_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/ExperiencePresetId"
        },
        "public_slug": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ],
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "venue_id": {
          "type": "string"
        }
      },
      "required": [
        "business_id",
        "tenant_id",
        "venue_id",
        "name",
        "public_slug",
        "preset_id",
        "status"
      ],
      "type": "object"
    },
    "ExperienceBranding": {
      "additionalProperties": false,
      "properties": {
        "brand_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "logo_url": {
          "format": "uri",
          "type": "string"
        },
        "primary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "secondary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        }
      },
      "required": [
        "brand_name"
      ],
      "type": "object"
    },
    "ExperienceChannels": {
      "additionalProperties": false,
      "properties": {
        "web_booking": {
          "type": "boolean"
        },
        "web_chat": {
          "type": "boolean"
        },
        "whatsapp": {
          "type": "boolean"
        }
      },
      "required": [
        "web_booking",
        "web_chat",
        "whatsapp"
      ],
      "type": "object"
    },
    "ExperienceConfigurationResponse": {
      "additionalProperties": false,
      "properties": {
        "branding": {
          "$ref": "#/$defs/ExperienceBranding"
        },
        "business_id": {
          "type": "string"
        },
        "channels": {
          "$ref": "#/$defs/ExperienceChannels"
        },
        "configuration_id": {
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/ExperiencePresetId"
        },
        "published_at": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExperienceConfigurationState"
        },
        "terminology": {
          "$ref": "#/$defs/ExperienceTerminology"
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "configuration_id",
        "business_id",
        "version",
        "state",
        "preset_id",
        "branding",
        "terminology",
        "channels",
        "updated_at"
      ],
      "type": "object"
    },
    "ExperienceConfigurationState": {
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "type": "string"
    },
    "ExperiencePresetId": {
      "enum": [
        "seat_capacity",
        "racing_gaming",
        "rooms_facilities",
        "appointments_salon",
        "sports_courts",
        "restaurant_tables",
        "cinema_events",
        "equipment_rental",
        "classes_workshops"
      ],
      "type": "string"
    },
    "ExperienceTerminology": {
      "additionalProperties": false,
      "properties": {
        "booking": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "customer",
        "resource",
        "booking"
      ],
      "type": "object"
    },
    "ExperienceWorkspaceResponse": {
      "additionalProperties": false,
      "properties": {
        "draft": {
          "$ref": "#/$defs/ExperienceConfigurationResponse"
        },
        "profile": {
          "$ref": "#/$defs/BusinessProfileResponse"
        },
        "published": {
          "$ref": "#/$defs/ExperienceConfigurationResponse"
        }
      },
      "required": [
        "profile"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/experience-workspace-response.schema.json",
  "$ref": "#/$defs/ExperienceWorkspaceResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperienceWorkspaceResponse"
}
