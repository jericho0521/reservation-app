{
  "name": "@reservation-platform/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Durable background worker host for the reservation platform.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
