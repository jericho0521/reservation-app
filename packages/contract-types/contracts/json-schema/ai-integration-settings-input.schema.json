{
  "$defs": {
    "AiIntegrationSettingsInput": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "maxLength": 4096,
          "minLength": 8,
          "type": "string",
          "writeOnly": true
        },
        "base_url": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "const": "openai",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "provider",
        "model"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/ai-integration-settings-input.schema.json",
  "$ref": "#/$defs/AiIntegrationSettingsInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiIntegrationSettingsInput"
}
