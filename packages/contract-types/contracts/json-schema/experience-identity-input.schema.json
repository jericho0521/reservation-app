{
  "$defs": {
    "ExperienceBranding": {
      "additionalProperties": false,
      "properties": {
        "brand_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "logo_url": {
          "format": "uri",
          "type": "string"
        },
        "primary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "secondary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        }
      },
      "required": [
        "brand_name"
      ],
      "type": "object"
    },
    "ExperienceIdentityInput": {
      "additionalProperties": false,
      "properties": {
        "branding": {
          "$ref": "#/$defs/ExperienceBranding"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "public_slug": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "terminology": {
          "$ref": "#/$defs/ExperienceTerminology"
        }
      },
      "required": [
        "name",
        "public_slug",
        "branding",
        "terminology"
      ],
      "type": "object"
    },
    "ExperienceTerminology": {
      "additionalProperties": false,
      "properties": {
        "booking": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "customer",
        "resource",
        "booking"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/experience-identity-input.schema.json",
  "$ref": "#/$defs/ExperienceIdentityInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperienceIdentityInput"
}
