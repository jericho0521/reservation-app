{
  "$defs": {
    "BusinessProfileResponse": {
      "additionalProperties": false,
      "properties": {
        "business_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/ExperiencePresetId"
        },
        "public_slug": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ],
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "venue_id": {
          "type": "string"
        }
      },
      "required": [
        "business_id",
        "tenant_id",
        "venue_id",
        "name",
        "public_slug",
        "preset_id",
        "status"
      ],
      "type": "object"
    },
    "ExperiencePresetId": {
      "enum": [
        "racing_gaming",
        "rooms_facilities",
        "appointments_salon",
        "sports_courts",
        "restaurant_tables",
        "cinema_events",
        "equipment_rental",
        "classes_workshops"
      ],
      "type": "string"
    },
    "InstallationBusinessResponse": {
      "additionalProperties": false,
      "properties": {
        "locations": {
          "items": {
            "$ref": "#/$defs/InstallationLocationResponse"
          },
          "minItems": 1,
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/BusinessProfileResponse"
        }
      },
      "required": [
        "profile",
        "locations"
      ],
      "type": "object"
    },
    "InstallationLocationResponse": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "location_id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "location_id",
        "name",
        "timezone"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/installation-business-response.schema.json",
  "$ref": "#/$defs/InstallationBusinessResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallationBusinessResponse"
}
