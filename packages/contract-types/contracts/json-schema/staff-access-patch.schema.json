{
  "$defs": {
    "StaffAccessPatch": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "active",
            "disabled"
          ],
          "type": "string"
        },
        "venue_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "venue_ids"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/staff-access-patch.schema.json",
  "$ref": "#/$defs/StaffAccessPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaffAccessPatch"
}
