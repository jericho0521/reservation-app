{
  "$defs": {
    "ConversationChannel": {
      "enum": [
        "web_chat",
        "whatsapp",
        "simulation"
      ],
      "type": "string"
    },
    "ListConversationsQuery": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/ConversationChannel"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "status": {
          "enum": [
            "active",
            "closed"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/list-conversations-query.schema.json",
  "$ref": "#/$defs/ListConversationsQuery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListConversationsQuery"
}
