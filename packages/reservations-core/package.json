{
  "name": "@project-play/reservations-core",
  "version": "0.0.0",
  "description": "Framework-neutral reservation domain logic, validation, availability, and repository contracts.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "license": "UNLICENSED",
  "author": "Project Play maintainers",
  "repository": {
    "type": "git",
    "url": "https://github.com/jericho0521/reservation-app.git",
    "directory": "packages/reservations-core"
  },
  "keywords": [
    "reservations",
    "booking",
    "availability",
    "capacity",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "tsc -p tsconfig.build.json && node --import tsx --test \"src/**/*.test.ts\" \"examples/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
