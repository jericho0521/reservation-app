{
  "$defs": {
    "StaffMemberResponse": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "email": {
          "format": "email",
          "maxLength": 320,
          "type": "string"
        },
        "status": {
          "enum": [
            "invited",
            "active",
            "disabled"
          ],
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        },
        "venue_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "user_id",
        "email",
        "display_name",
        "status",
        "venue_ids"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/staff-member-response.schema.json",
  "$ref": "#/$defs/StaffMemberResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaffMemberResponse"
}
