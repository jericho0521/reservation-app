{
  "$defs": {
    "ExperienceBranding": {
      "additionalProperties": false,
      "properties": {
        "brand_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "logo_url": {
          "format": "uri",
          "type": "string"
        },
        "primary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "secondary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        }
      },
      "required": [
        "brand_name"
      ],
      "type": "object"
    },
    "ExperienceChannels": {
      "additionalProperties": false,
      "properties": {
        "web_booking": {
          "type": "boolean"
        },
        "web_chat": {
          "type": "boolean"
        },
        "whatsapp": {
          "type": "boolean"
        }
      },
      "required": [
        "web_booking",
        "web_chat",
        "whatsapp"
      ],
      "type": "object"
    },
    "ExperienceConfigurationResponse": {
      "additionalProperties": false,
      "properties": {
        "branding": {
          "$ref": "#/$defs/ExperienceBranding"
        },
        "business_id": {
          "type": "string"
        },
        "channels": {
          "$ref": "#/$defs/ExperienceChannels"
        },
        "configuration_id": {
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/ExperiencePresetId"
        },
        "published_at": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExperienceConfigurationState"
        },
        "terminology": {
          "$ref": "#/$defs/ExperienceTerminology"
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "configuration_id",
        "business_id",
        "version",
        "state",
        "preset_id",
        "branding",
        "terminology",
        "channels",
        "updated_at"
      ],
      "type": "object"
    },
    "ExperienceConfigurationState": {
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "type": "string"
    },
    "ExperiencePresetId": {
      "enum": [
        "seat_capacity",
        "racing_gaming",
        "rooms_facilities",
        "appointments_salon",
        "sports_courts",
        "restaurant_tables",
        "cinema_events",
        "equipment_rental",
        "classes_workshops"
      ],
      "type": "string"
    },
    "ExperienceTerminology": {
      "additionalProperties": false,
      "properties": {
        "booking": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "customer",
        "resource",
        "booking"
      ],
      "type": "object"
    },
    "PublicBusinessProfileResponse": {
      "additionalProperties": false,
      "properties": {
        "business_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/ExperiencePresetId"
        },
        "public_slug": {
          "type": "string"
        }
      },
      "required": [
        "business_id",
        "name",
        "public_slug",
        "preset_id"
      ],
      "type": "object"
    },
    "PublicExperienceResponse": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "allOf": [
            {
              "$ref": "#/$defs/ExperienceConfigurationResponse"
            },
            {
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "published",
                  "type": "string"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            }
          ]
        },
        "profile": {
          "$ref": "#/$defs/PublicBusinessProfileResponse"
        }
      },
      "required": [
        "profile",
        "configuration"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/public-experience-response.schema.json",
  "$ref": "#/$defs/PublicExperienceResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicExperienceResponse"
}
