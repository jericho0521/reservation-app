{
  "$defs": {
    "IdempotencyMetadata": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "replayed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "created",
            "replayed",
            "rejected"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "JsonPrimitive": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "PlatformErrorBody": {
      "additionalProperties": false,
      "properties": {
        "causes": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        "code": {
          "$ref": "#/$defs/PlatformErrorCode"
        },
        "details": {
          "$ref": "#/$defs/JsonValue"
        },
        "documentation_url": {
          "type": "string"
        },
        "idempotency": {
          "$ref": "#/$defs/IdempotencyMetadata"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "status": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message",
        "status"
      ],
      "type": "object"
    },
    "PlatformErrorCode": {
      "anyOf": [
        {
          "enum": [
            "bad_request",
            "unauthorized",
            "forbidden",
            "not_found",
            "conflict",
            "validation_failed",
            "missing_idempotency_key",
            "idempotency_key_reused_with_different_request",
            "idempotency_replay_unavailable",
            "chat_module_disabled",
            "whatsapp_module_disabled",
            "internal_error",
            "rate_limited",
            "payload_too_large"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "Stable machine-readable platform error code. The enum lists codes defined by this release; compatible extensions remain valid strings."
    },
    "PlatformErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/PlatformErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/platform-error-response.schema.json",
  "$ref": "#/$defs/PlatformErrorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlatformErrorResponse"
}
