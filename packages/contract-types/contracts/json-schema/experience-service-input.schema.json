{
  "$defs": {
    "ExperienceServiceInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1000,
          "type": "string"
        },
        "duration_minutes": {
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "resource_kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "resource_strategy": {
          "$ref": "#/$defs/ResourceStrategy"
        },
        "total_quantity": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "duration_minutes",
        "total_quantity",
        "resource_kind",
        "resource_strategy"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "seat",
        "station",
        "room",
        "court",
        "screening",
        "capacity_bucket",
        "custom"
      ],
      "type": "string"
    },
    "ResourceStrategy": {
      "enum": [
        "quantity",
        "assigned_resource",
        "hybrid"
      ],
      "type": "string"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/experience-service-input.schema.json",
  "$ref": "#/$defs/ExperienceServiceInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperienceServiceInput"
}
