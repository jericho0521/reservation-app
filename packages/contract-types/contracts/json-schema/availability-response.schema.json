{
  "$defs": {
    "AvailabilityResponse": {
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "#/$defs/ResourceLayoutResponse"
        },
        "reservation_policy": {
          "$ref": "#/$defs/JsonValue"
        },
        "resource_kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "resource_strategy": {
          "$ref": "#/$defs/ResourceStrategy"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceResponse"
          },
          "type": "array"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/AvailabilitySlot"
          },
          "type": "array"
        },
        "total_quantity": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "slots"
      ],
      "type": "object"
    },
    "AvailabilitySlot": {
      "additionalProperties": false,
      "properties": {
        "available_quantity": {
          "minimum": 0,
          "type": "integer"
        },
        "end_at": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "is_available": {
          "type": "boolean"
        },
        "maintenance_resource_labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resource_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "staff_id": {
          "format": "uuid",
          "type": "string"
        },
        "start_at": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "taken_resource_labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "available_quantity",
        "is_available"
      ],
      "type": "object"
    },
    "JsonPrimitive": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "MetadataRecord": {
      "additionalProperties": {
        "$ref": "#/$defs/MetadataValue"
      },
      "type": "object"
    },
    "MetadataValue": {
      "$ref": "#/$defs/JsonPrimitive"
    },
    "ResourceKind": {
      "enum": [
        "seat",
        "station",
        "room",
        "court",
        "screening",
        "capacity_bucket",
        "custom"
      ],
      "type": "string"
    },
    "ResourceLayoutResource": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "resource_id": {
          "type": "string"
        },
        "row": {
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "resource_id"
      ],
      "type": "object"
    },
    "ResourceLayoutResponse": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "grid",
            "custom"
          ],
          "type": "string"
        },
        "layout_id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceLayoutResource"
          },
          "type": "array"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "layout_id",
        "kind"
      ],
      "type": "object"
    },
    "ResourceResponse": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "minimum": 0,
          "type": "integer"
        },
        "is_active": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "resource_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "label",
        "kind",
        "is_active"
      ],
      "type": "object"
    },
    "ResourceStrategy": {
      "enum": [
        "quantity",
        "assigned_resource",
        "hybrid"
      ],
      "type": "string"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/availability-response.schema.json",
  "$ref": "#/$defs/AvailabilityResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvailabilityResponse"
}
