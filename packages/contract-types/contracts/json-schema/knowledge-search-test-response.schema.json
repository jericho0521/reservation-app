{
  "$defs": {
    "KnowledgeSearchMatchResponse": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "type": "string"
        },
        "combined_score": {
          "type": "number"
        },
        "excerpt": {
          "type": "string"
        },
        "lexical_rank": {
          "minimum": 1,
          "type": "integer"
        },
        "semantic_rank": {
          "minimum": 1,
          "type": "integer"
        },
        "semantic_similarity": {
          "type": "number"
        },
        "source_id": {
          "type": "string"
        },
        "source_label": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "source_id",
        "source_label",
        "excerpt",
        "combined_score"
      ],
      "type": "object"
    },
    "KnowledgeSearchTestResponse": {
      "additionalProperties": false,
      "properties": {
        "matches": {
          "items": {
            "$ref": "#/$defs/KnowledgeSearchMatchResponse"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "matches"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/knowledge-search-test-response.schema.json",
  "$ref": "#/$defs/KnowledgeSearchTestResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeSearchTestResponse"
}
