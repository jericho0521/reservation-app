# Reservation Platform Backend API
# Copy this file to .env for local Docker/Compose runs.

# HTTP server
PORT=4100

# Backend-owned Supabase configuration.
# These values must stay server-side and must never be exposed to frontend apps.
RESERVATION_SUPABASE_URL=
RESERVATION_SUPABASE_ANON_KEY=
RESERVATION_SUPABASE_SERVICE_ROLE_KEY=

# Choose at least one backend auth mode.
# Simple service-token mode for demos/internal clients:
RESERVATION_PLATFORM_SERVICE_API_KEY=

# Or provider-neutral JWT/JWKS mode:
RESERVATION_PLATFORM_AUTH_JWKS_URL=
RESERVATION_PLATFORM_AUTH_ISSUER=
RESERVATION_PLATFORM_AUTH_AUDIENCE=
RESERVATION_PLATFORM_AUTH_ALGORITHMS=RS256
RESERVATION_PLATFORM_AUTH_CLOCK_TOLERANCE_SECONDS=30
RESERVATION_PLATFORM_AUTH_JWKS_CACHE_TTL_SECONDS=300
RESERVATION_PLATFORM_AUTH_SUBJECT_CLAIM=sub
RESERVATION_PLATFORM_AUTH_TENANT_IDS_CLAIM=tenant_ids
RESERVATION_PLATFORM_AUTH_VENUE_IDS_CLAIM=venue_ids
RESERVATION_PLATFORM_AUTH_ROLES_CLAIM=roles
RESERVATION_PLATFORM_AUTH_SCOPES_CLAIM=scopes

# Browser frontend origins allowed to call this backend.
# Example: http://localhost:4000,https://restaurant-demo.example.com
RESERVATION_PLATFORM_CORS_ALLOWED_ORIGINS=http://localhost:4000

# Optional backend module manifest. Docker Compose mounts the example manifest
# to /app/config/platform.json. Keep secrets in env vars, not this JSON file.
RESERVATION_PLATFORM_CONFIG_PATH=/app/config/platform.json

# Optional legacy AI chat provider configuration.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=

# Optional provider-neutral AI agent runtime for WhatsApp booking automation.
# For OpenRouter, use AI_AGENT_PROVIDER=openai-compatible and
# AI_AGENT_BASE_URL=https://openrouter.ai/api/v1.
AI_AGENT_PROVIDER=openai-compatible
AI_AGENT_BASE_URL=
AI_AGENT_API_KEY=
AI_AGENT_MODEL=

# Optional WhatsApp channel module.
# session_qr is self-hosted linked-device QR mode for one business deployment.
RESERVATION_WHATSAPP_ENABLED=false
RESERVATION_WHATSAPP_PROVIDER=session_qr
RESERVATION_WHATSAPP_SESSION_AUTH_DIR=.reservation-whatsapp-sessions
RESERVATION_WHATSAPP_SESSION_ENCRYPTION_KEY=
# Dev/test only. Production WhatsApp requires Supabase/Postgres storage.
RESERVATION_WHATSAPP_ALLOW_MEMORY_STORE=false
# Dev/test only. Enables POST /v1/channels/whatsapp/messages:simulate.
RESERVATION_WHATSAPP_SIMULATION_ENABLED=false
