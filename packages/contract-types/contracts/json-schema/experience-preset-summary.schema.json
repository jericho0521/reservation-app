{
  "$defs": {
    "ExperiencePresetId": {
      "enum": [
        "racing_gaming",
        "rooms_facilities",
        "appointments_salon",
        "sports_courts",
        "restaurant_tables",
        "cinema_events",
        "equipment_rental",
        "classes_workshops"
      ],
      "type": "string"
    },
    "ExperiencePresetSummary": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/ExperiencePresetId"
        },
        "resource_strategy": {
          "$ref": "#/$defs/ResourceStrategy"
        },
        "terminology": {
          "$ref": "#/$defs/ExperienceTerminology"
        }
      },
      "required": [
        "preset_id",
        "name",
        "description",
        "resource_strategy",
        "terminology"
      ],
      "type": "object"
    },
    "ExperienceTerminology": {
      "additionalProperties": false,
      "properties": {
        "booking": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "customer",
        "resource",
        "booking"
      ],
      "type": "object"
    },
    "ResourceStrategy": {
      "enum": [
        "quantity",
        "assigned_resource",
        "hybrid"
      ],
      "type": "string"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/experience-preset-summary.schema.json",
  "$ref": "#/$defs/ExperiencePresetSummary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperiencePresetSummary"
}
