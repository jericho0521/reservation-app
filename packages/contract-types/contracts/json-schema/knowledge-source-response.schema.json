{
  "$defs": {
    "KnowledgeSourceResponse": {
      "additionalProperties": false,
      "properties": {
        "chunk_count": {
          "minimum": 0,
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "failure_code": {
          "type": "string"
        },
        "indexed_at": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "faq",
            "text",
            "pdf"
          ],
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "source_label": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "indexing",
            "ready",
            "failed",
            "archived"
          ],
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title",
        "source_label",
        "status",
        "chunk_count",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/knowledge-source-response.schema.json",
  "$ref": "#/$defs/KnowledgeSourceResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeSourceResponse"
}
