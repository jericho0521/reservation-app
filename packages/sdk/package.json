{
  "name": "@reservation-platform/sdk",
  "version": "0.1.0",
  "description": "Frontend-safe TypeScript client for the reservation platform API.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Project Play maintainers",
  "repository": {
    "type": "git",
    "url": "https://github.com/jericho0521/reservation-app.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "tsc -p tsconfig.build.json && node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reservation-platform/contract-types": "workspace:^"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
