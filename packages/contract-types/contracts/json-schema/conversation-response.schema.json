{
  "$defs": {
    "ConversationAutomationState": {
      "enum": [
        "automated",
        "manual"
      ],
      "type": "string"
    },
    "ConversationChannel": {
      "enum": [
        "web_chat",
        "whatsapp",
        "simulation"
      ],
      "type": "string"
    },
    "ConversationParticipantResponse": {
      "additionalProperties": false,
      "properties": {
        "contact_hint": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "participant_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "customer",
            "staff",
            "automation"
          ],
          "type": "string"
        }
      },
      "required": [
        "participant_id",
        "role"
      ],
      "type": "object"
    },
    "ConversationResponse": {
      "additionalProperties": false,
      "properties": {
        "automation_state": {
          "$ref": "#/$defs/ConversationAutomationState"
        },
        "channel": {
          "$ref": "#/$defs/ConversationChannel"
        },
        "conversation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "last_message_at": {
          "type": "string"
        },
        "participant": {
          "$ref": "#/$defs/ConversationParticipantResponse"
        },
        "reservation_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "closed"
          ],
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "venue_id": {
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "tenant_id",
        "venue_id",
        "channel",
        "status",
        "automation_state",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/conversation-response.schema.json",
  "$ref": "#/$defs/ConversationResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationResponse"
}
