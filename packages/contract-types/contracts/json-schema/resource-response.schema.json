{
  "$defs": {
    "JsonPrimitive": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "MetadataRecord": {
      "additionalProperties": {
        "$ref": "#/$defs/MetadataValue"
      },
      "type": "object"
    },
    "MetadataValue": {
      "$ref": "#/$defs/JsonPrimitive"
    },
    "ResourceKind": {
      "enum": [
        "seat",
        "station",
        "room",
        "court",
        "screening",
        "capacity_bucket",
        "custom"
      ],
      "type": "string"
    },
    "ResourceResponse": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "minimum": 0,
          "type": "integer"
        },
        "is_active": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "resource_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "label",
        "kind",
        "is_active"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/resource-response.schema.json",
  "$ref": "#/$defs/ResourceResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceResponse"
}
