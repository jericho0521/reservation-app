{
  "name": "@reservation-platform/api",
  "version": "0.0.0",
  "description": "Framework-neutral reservation platform API adapters and compatibility services.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Project Play maintainers",
  "repository": {
    "type": "git",
