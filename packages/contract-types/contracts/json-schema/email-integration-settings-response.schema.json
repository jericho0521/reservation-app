{
  "$defs": {
    "EmailIntegrationSettingsResponse": {
      "additionalProperties": false,
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "credential_present": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "from_address": {
          "format": "email",
          "maxLength": 320,
          "type": "string"
        },
        "from_name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "host": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "provider": {
          "const": "smtp",
          "type": "string"
        },
        "tls_mode": {
          "$ref": "#/$defs/EmailTlsMode"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "provider",
        "configured",
        "credential_present"
      ],
      "type": "object"
    },
    "EmailTlsMode": {
      "enum": [
        "required",
        "starttls",
        "plain"
      ],
      "type": "string"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/email-integration-settings-response.schema.json",
  "$ref": "#/$defs/EmailIntegrationSettingsResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailIntegrationSettingsResponse"
}
