{
  "$defs": {
    "ExperienceBranding": {
      "additionalProperties": false,
      "properties": {
        "brand_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "logo_url": {
          "format": "uri",
          "type": "string"
        },
        "primary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "secondary_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        }
      },
      "required": [
        "brand_name"
      ],
      "type": "object"
    },
    "ExperienceChannels": {
      "additionalProperties": false,
      "properties": {
        "web_booking": {
          "type": "boolean"
        },
        "web_chat": {
          "type": "boolean"
        },
        "whatsapp": {
          "type": "boolean"
        }
      },
      "required": [
        "web_booking",
        "web_chat",
        "whatsapp"
      ],
      "type": "object"
    },
    "ExperienceDraftInput": {
      "additionalProperties": false,
      "properties": {
        "branding": {
          "$ref": "#/$defs/ExperienceBranding"
        },
        "channels": {
          "$ref": "#/$defs/ExperienceChannels"
        },
        "preset_id": {
          "$ref": "#/$defs/ExperiencePresetId"
        },
        "terminology": {
          "$ref": "#/$defs/ExperienceTerminology"
        }
      },
      "required": [
        "preset_id",
        "branding",
        "terminology",
        "channels"
      ],
      "type": "object"
    },
    "ExperiencePresetId": {
      "enum": [
        "seat_capacity",
        "racing_gaming",
        "rooms_facilities",
        "appointments_salon",
        "sports_courts",
        "restaurant_tables",
        "cinema_events",
        "equipment_rental",
        "classes_workshops"
      ],
      "type": "string"
    },
    "ExperienceTerminology": {
      "additionalProperties": false,
      "properties": {
        "booking": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "customer",
        "resource",
        "booking"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/experience-draft-input.schema.json",
  "$ref": "#/$defs/ExperienceDraftInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperienceDraftInput"
}
