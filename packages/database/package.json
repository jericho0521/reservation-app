{
  "name": "@reservation-platform/database",
  "version": "0.0.0",
  "private": true,
  "description": "Backend-owned reservation platform database migration bundle scaffold.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "files": [
    "dist",
    "migrations",
    "seeds",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "index:generate": "node ../../scripts/generate-database-migration-index.mjs",
    "index:check": "node ../../scripts/generate-database-migration-index.mjs --check",
    "live-proof": "node ../../scripts/verify-database-live-proof.mjs",
    "live-proof:strict": "node ../../scripts/verify-database-live-proof.mjs --strict",
    "prepack": "pnpm run build",
    "test": "tsc -p tsconfig.build.json && node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run index:check && node ../../scripts/verify-database-migration-bundle.mjs"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
