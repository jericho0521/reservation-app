    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reservation-platform/contract-types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5"
