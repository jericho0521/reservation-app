{
  "$defs": {
    "ConversationAutomationState": {
      "enum": [
        "automated",
        "manual"
      ],
      "type": "string"
    },
    "ConversationBookingProposalResponse": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "practitioner_name": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "type": "integer"
        },
        "service_id": {
          "type": "string"
        },
        "service_name": {
          "type": "string"
        },
        "staff_id": {
          "format": "uuid",
          "type": "string"
        },
        "start_time": {
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "service_id",
        "service_name",
        "date",
        "start_time",
        "end_time",
        "quantity"
      ],
      "type": "object"
    },
    "ConversationChannel": {
      "enum": [
        "web_chat",
        "whatsapp",
        "simulation"
      ],
      "type": "string"
    },
    "ConversationDeliveryState": {
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed"
      ],
      "type": "string"
    },
    "ConversationMessageResponse": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/ConversationChannel"
        },
        "content": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "delivery_state": {
          "$ref": "#/$defs/ConversationDeliveryState"
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound"
          ],
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "sender_type": {
          "enum": [
            "customer",
            "automation",
            "staff",
            "system"
          ],
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeCitationResponse"
          },
          "maxItems": 3,
          "type": "array"
        }
      },
      "required": [
        "message_id",
        "conversation_id",
        "channel",
        "direction",
        "sender_type",
        "delivery_state",
        "content",
        "created_at"
      ],
      "type": "object"
    },
    "CustomerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "external_customer_id": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "JsonPrimitive": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "KnowledgeCitationResponse": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "label"
      ],
      "type": "object"
    },
    "MetadataRecord": {
      "additionalProperties": {
        "$ref": "#/$defs/MetadataValue"
      },
      "type": "object"
    },
    "MetadataValue": {
      "$ref": "#/$defs/JsonPrimitive"
    },
    "PaymentReference": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "payment_reference_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "PublicChatConversationResponse": {
      "additionalProperties": false,
      "properties": {
        "automation_state": {
          "$ref": "#/$defs/ConversationAutomationState"
        },
        "automation_suppressed": {
          "type": "boolean"
        },
        "conversation_id": {
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/ConversationMessageResponse"
        },
        "proposal": {
          "$ref": "#/$defs/ConversationBookingProposalResponse"
        },
        "reservation": {
          "$ref": "#/$defs/ReservationResponse"
        }
      },
      "required": [
        "conversation_id",
        "automation_state"
      ],
      "type": "object"
    },
    "ReservationItemInput": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "minimum": 1,
          "type": "integer"
        },
        "resource_id": {
          "type": "string"
        },
        "resource_label": {
          "type": "string"
        }
      },
      "required": [
        "quantity"
      ],
      "type": "object"
    },
    "ReservationResponse": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "customer": {
          "$ref": "#/$defs/CustomerSnapshot"
        },
        "date": {
          "type": "string"
        },
        "end_at": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "management_expires_at": {
          "type": "string"
        },
        "management_link_status": {
          "enum": [
            "issued",
            "unavailable"
          ],
          "type": "string"
        },
        "management_reissue_required": {
          "type": "boolean"
        },
        "management_token": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "payment_reference": {
          "$ref": "#/$defs/PaymentReference"
        },
        "quantity": {
          "minimum": 1,
          "type": "integer"
        },
        "reservation_id": {
          "type": "string"
        },
        "reservation_items": {
          "items": {
            "$ref": "#/$defs/ReservationItemInput"
          },
          "type": "array"
        },
        "service_id": {
          "type": "string"
        },
        "staff_id": {
          "format": "uuid",
          "type": "string"
        },
        "start_at": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "venue_id": {
          "type": "string"
        }
      },
      "required": [
        "reservation_id",
        "status",
        "service_id",
        "quantity"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/public-chat-conversation-response.schema.json",
  "$ref": "#/$defs/PublicChatConversationResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicChatConversationResponse"
}
