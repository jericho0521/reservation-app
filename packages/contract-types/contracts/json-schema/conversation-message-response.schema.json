{
  "$defs": {
    "ConversationChannel": {
      "enum": [
        "web_chat",
        "whatsapp",
        "simulation"
      ],
      "type": "string"
    },
    "ConversationDeliveryState": {
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed"
      ],
      "type": "string"
    },
    "ConversationMessageResponse": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/ConversationChannel"
        },
        "content": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "delivery_state": {
          "$ref": "#/$defs/ConversationDeliveryState"
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound"
          ],
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "sender_type": {
          "enum": [
            "customer",
            "automation",
            "staff",
            "system"
          ],
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeCitationResponse"
          },
          "maxItems": 3,
          "type": "array"
        }
      },
      "required": [
        "message_id",
        "conversation_id",
        "channel",
        "direction",
        "sender_type",
        "delivery_state",
        "content",
        "created_at"
      ],
      "type": "object"
    },
    "KnowledgeCitationResponse": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "label"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/conversation-message-response.schema.json",
  "$ref": "#/$defs/ConversationMessageResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationMessageResponse"
}
