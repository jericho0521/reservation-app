{
  "$defs": {
    "AuthenticatedSessionResponse": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PlatformUserRole"
        },
        "tenant_id": {
          "minLength": 1,
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        },
        "venue_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "user_id",
        "tenant_id",
        "role",
        "venue_ids",
        "expires_at"
      ],
      "type": "object"
    },
    "PlatformUserRole": {
      "enum": [
        "owner",
        "staff"
      ],
      "type": "string"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/authenticated-session-response.schema.json",
  "$ref": "#/$defs/AuthenticatedSessionResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthenticatedSessionResponse"
}
