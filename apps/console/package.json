{
  "name": "@reservation-platform/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev -p 4300",
    "build": "next build",
    "start": "next start -p 4300",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:standalone": "node --test lib/standalone-base-path.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "verify": "pnpm run test && pnpm run typecheck && pnpm run build && pnpm run test:standalone"
  },
  "dependencies": {
    "@reservation-platform/sdk": "workspace:*",
    "@reservation-platform/ui": "workspace:*",
    "next": "^16.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
