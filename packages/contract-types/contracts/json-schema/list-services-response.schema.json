{
  "$defs": {
    "JsonPrimitive": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "ListServicesResponse": {
      "additionalProperties": false,
      "properties": {
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceResponse"
          },
          "type": "array"
        }
      },
      "required": [
        "services"
      ],
      "type": "object"
    },
    "MetadataRecord": {
      "additionalProperties": {
        "$ref": "#/$defs/MetadataValue"
      },
      "type": "object"
    },
    "MetadataValue": {
      "$ref": "#/$defs/JsonPrimitive"
    },
    "ResourceKind": {
      "enum": [
        "seat",
        "station",
        "room",
        "court",
        "screening",
        "capacity_bucket",
        "custom"
      ],
      "type": "string"
    },
    "ResourceLayoutResource": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "resource_id": {
          "type": "string"
        },
        "row": {
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "resource_id"
      ],
      "type": "object"
    },
    "ResourceLayoutResponse": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "grid",
            "custom"
          ],
          "type": "string"
        },
        "layout_id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceLayoutResource"
          },
          "type": "array"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "layout_id",
        "kind"
      ],
      "type": "object"
    },
    "ResourceResponse": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "minimum": 0,
          "type": "integer"
        },
        "is_active": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "label": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "resource_id": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "label",
        "kind",
        "is_active"
      ],
      "type": "object"
    },
    "ResourceStrategy": {
      "enum": [
        "quantity",
        "assigned_resource",
        "hybrid"
      ],
      "type": "string"
    },
    "ServiceResponse": {
      "additionalProperties": false,
      "properties": {
        "booking_mode": {
          "enum": [
            "resource",
            "appointment"
          ],
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "duration_minutes": {
          "minimum": 1,
          "type": "integer"
        },
        "is_active": {
          "type": "boolean"
        },
        "layout": {
          "$ref": "#/$defs/ResourceLayoutResponse"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataRecord"
        },
        "name": {
          "type": "string"
        },
        "reservation_policy": {
          "$ref": "#/$defs/JsonValue"
        },
        "resource_kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "resource_strategy": {
          "$ref": "#/$defs/ResourceStrategy"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceResponse"
          },
          "type": "array"
        },
        "service_id": {
          "type": "string"
        },
        "total_quantity": {
          "minimum": 0,
          "type": "integer"
        },
        "venue_id": {
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "name"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/list-services-response.schema.json",
  "$ref": "#/$defs/ListServicesResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListServicesResponse"
}
