{
  "$defs": {
    "StaffInvitationResponse": {
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "enum": [
            "email",
            "manual"
          ],
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "invitation_token": {
          "maxLength": 128,
          "minLength": 43,
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "delivery",
        "expires_at"
      ],
      "type": "object"
    }
  },
  "$id": "https://reservation-platform.local/contracts/json-schema/staff-invitation-response.schema.json",
  "$ref": "#/$defs/StaffInvitationResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaffInvitationResponse"
}
